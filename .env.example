# Copy this file to `.env` and fill in the values.
# `.env` is ignored by git and must never be committed.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# True only for local development.
DEBUG=True

# Comma-separated host names the site is served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Production only (DEBUG=False). Leave commented out for local development.
# With DEBUG=False the site works over HTTPS only: plain HTTP is redirected and
# cookies are marked secure. To try DEBUG=False locally over HTTP, set:
#HTTPS_ONLY=False
# Addresses the site is opened at, with the scheme, comma-separated.
#CSRF_TRUSTED_ORIGINS=https://forum.example.com
# True if a reverse proxy (nginx, hosting platform) handles HTTPS for the app.
#BEHIND_HTTPS_PROXY=True
# How long browsers remember to use HTTPS, in seconds.
#SECURE_HSTS_SECONDS=3600

# Redis base URL without a database number, e.g. redis://localhost:6379
# Leave empty to run without Redis (in-memory cache, synchronous Celery tasks).
REDIS_URL=

# E-mail. With the default console backend messages are printed to the terminal.
# For a real SMTP server use django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
DEFAULT_FROM_EMAIL=noreply@localhost

# Log level for the application code: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
